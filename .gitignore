__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Données produites à l'exécution — jamais versionnées.
# NB : le paquet source quarantine/ (quarantine_manager.py) DOIT l'être ;
# le stockage réel des fichiers isolés est quarantine_storage/.
logs/*.log
quarantine_storage/
triage_staging/
organizer_logs/
cache/
signatures/vt_api_key.txt

# Etat d'execution du lanceur (pid, port, jeton de session)
runtime.json

# Donnees produites par les modules V2
history/
incident/
camera/

# État d'exécution de la couche assistant. En développement, paths.data_path()
# retombe volontairement sur le dossier du projet (voir paths.py) : la mémoire,
# le journal des décisions et les notifications s'écrivent donc ICI. Ce sont des
# données d'une session, pas des sources — et elles peuvent contenir des chemins
# personnels et l'historique d'usage de la machine. Elles ne doivent jamais
# partir sur un dépôt public.
assistant/memoire.json
assistant/notifications.json
assistant/*.json
